{
  "enabledPlugins": {
    "magicpath@magicpath": true
  },
  "extraKnownMarketplaces": {
    "magicpath": {
      "source": {
        "source": "github",
        "repo": "MagicPathAI/magicpath-agent-plugin"
      }
    }
  },
  "theme": "dark",
  "tui": "fullscreen",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sachinkoli/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
